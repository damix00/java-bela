{
  "name": "bela",
  "version": "0.1.0",
  "private": true,
  "description": "Belote card game — Spring Boot API and Next.js web client",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm redis:up && concurrently -n api,web,admin -c blue,magenta,green \"pnpm:dev:api\" \"pnpm:dev:web\" \"pnpm:dev:admin\"",
    "dev:api": "cd apps/api && ./gradlew bootRun",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm build:api && pnpm build:web && pnpm build:admin",
    "build:api": "cd apps/api && ./gradlew build",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "test": "cd apps/api && ./gradlew test",
    "lint": "pnpm --filter web lint && pnpm --filter admin lint",
    "typecheck": "pnpm -r typecheck",
    "protocol": "cd apps/api && ./gradlew generateTypeScript",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
