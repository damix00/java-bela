{
  "name": "bela",
  "version": "0.1.0",
  "private": true,
  "description": "Belote card game — Spring Boot API and Next.js web client",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run redis:up && concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd apps/api && ./gradlew bootRun",
    "dev:web": "npm --prefix apps/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd apps/api && ./gradlew build",
    "build:web": "npm --prefix apps/web run build",
    "test": "cd apps/api && ./gradlew test",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --workspace @bela/protocol run typecheck",
    "protocol": "cd apps/api && ./gradlew generateTypeScript",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
