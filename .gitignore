# OS
.DS_Store

# Redis dumps
*.rdb

# Node (root workspace)
node_modules/

# Editors
# .idea/* rather than .idea/ so git still descends into it and the negation
# below can take effect — an excluded *directory* is never walked at all.
**/.idea/*
!**/.idea/runConfigurations/
*.iml
.vscode/

docs/superpowers/*

# Env
.env
.env.local
