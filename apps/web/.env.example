# Server -> server. Never exposed to the browser; this is the origin the BFF
# (server actions and /api/auth/refresh) calls to reach the Spring API.
INTERNAL_API_URL=http://localhost:8080

# Must equal INTERNAL_API_KEY in apps/api/.env. Sent as X-Internal-Source-Token
# so the backend recognises the Next server as a trusted caller.
INTERNAL_API_KEY_SB=change-me

# Browser -> API, used by apiFetch for authenticated calls that carry the
# access token directly rather than going through the BFF.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Set to "true" in production. Omitting it ships session cookies without the
# Secure flag, which is why it is spelled out here rather than left implicit.
SECURE_COOKIES=false

# Browser -> API WebSocket. The lobby has no REST surface at all, so this is the
# only way to reach it. Same host as NEXT_PUBLIC_API_URL, ws:// scheme, /ws path
# — the access token rides in the query string because a browser WebSocket
# cannot set an Authorization header.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
